POSTGRES_USER=fitplan
POSTGRES_PASSWORD=very_secure_password
POSTGRES_DB=fitplan
POSTGRES_PORT=5432
MONGO_INITDB_ROOT_USERNAME=fitplan
MONGO_INITDB_ROOT_PASSWORD=very_secure_password
MONGO_PORT=27017

# Backend (B-01, B-02). Generate the secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
LOG_LEVEL=INFO

# MongoDB buffer (DB-02). The backend builds its URL from MONGO_INITDB_ROOT_* above; override with MONGO_URL if needed.
MONGO_DB=fitplan
RECOGNITION_TTL_HOURS=6

# Meal photos (B-05 deletes meals/<user id>/ below this directory; B-19 will write there). Unset = no photo storage.
# PHOTO_DIR=/data/photos

# Hardening and capacity (B-29), see backend/README.md. Defaults shown.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=1800
# MAX_BODY_BYTES=1048576
# MAX_UPLOAD_BYTES=9437184
# CORS_ORIGINS=
# HSTS_MAX_AGE_SECONDS=0

# Scheduler and push (B-26), see backend/README.md. Defaults shown.
# PUSH_ENABLED=true
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# EXPO_ACCESS_TOKEN=
# SCHEDULER_INTERVAL_SECONDS=900

# Docker stack (B-01): published API port and uvicorn workers (workers x pool must fit PostgreSQL max_connections).
# API_PORT=8000
# WEB_WORKERS=4
